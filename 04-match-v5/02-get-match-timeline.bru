meta {
  name: 02 - Get Match Timeline
  type: http
  seq: 2
}

get {
  url: {{base_url_regional}}{{api_prefix_match}}/matches/{{match_id}}/timeline
  body: none
  auth: none
}

headers {
  X-Riot-Token: {{riot_api_key}}
  Accept: application/json
}

tests {
  test("Status 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Timeline tem frames", function() {
    const body = res.getBody();
    expect(body.info).to.have.property("frames");
    expect(body.info.frames).to.be.an("array");
    expect(body.info.frames.length).to.be.greaterThan(0);
  });
}
